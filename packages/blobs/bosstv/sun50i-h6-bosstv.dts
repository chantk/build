	aliases {
		mmc0 = "/soc/mmc@4020000"; // MicroSD
		mmc1 = "/soc/mmc@4021000"; // SDIO Wifi
		mmc2 = "/soc/mmc@4022000"; // eMMC
		ethernet1 = "/soc/ethernet@5020000";
//		ethernet1 = "/soc/mmc@4021000/sdio_wifi@1";
		serial0 = "/soc/serial@5000000";
		serial1 = "/soc/serial@5000400";
	};

	chosen {
		linux,initrd-end = <0x49fff186>;
		linux,initrd-start = <0x496fb000>;
		bootargs = "root=UUID=270e20f5-f8b9-49e1-8231-5728f115598b console=ttyS0,115200 console=tty0 mem=2048M video=HDMI-A-1:e rootflags=data=writeback rw no_console_suspend consoleblank=0 fsck.fix=yes fsck.repair=yes net.ifnames=0 bootsplash.bootfile=bootsplash.armbian";
		stdout-path = "serial0:115200n8";
	};

	connector {
		compatible = "hdmi-connector";
		ddc-en-gpios = <0x1b 0x07 0x02 0x00>;
		type = "a";

		port {

			endpoint {
				remote-endpoint = <0x48>;
				phandle = <0x35>;
			};
		};
	};

	/* FD655 front-panel clock. Android clk_pin = PH3, dat_pin = PD26.
	 * The 5.15 module (drivers/misc/openvfd/openvfd.ko) matches
	 * "open,vfd" only. It takes clk/dat with of_get_named_gpio_flags
	 * (&pio bank pin flags; 0 = active-high). A string stb property
	 * makes request_pin fail and probe abort; FD650/FD655 is 2-wire,
	 * so stb is omitted. openvfd_display_type is read with
	 * of_property_read_u32 into {type, reserved, flags, controller}
	 * on little-endian, so the cell is byte-swapped: 0x05000001
	 * becomes type=0x01, controller=0x05 (CONTROLLER_FD655). This
	 * panel is FD655. FD650 would be 0x03000001 (controller 0x03).
	 */
	/* Unisoc UWE5621/UWE5622. The Allwinner build of the uwe5622 driver
	 * registers itself, then aborts unless this node exists: it reads
	 * bt_hostwake (Android btlpm, PM1) as the BT wake IRQ.
	 * WiFi is SDIO on mmc1. Bluetooth is the SDIO tty (sprd,mtty),
	 * which appears as ttyBT. UART1 is the same pins Android used.
	 */
	btlpm {
		compatible = "allwinner,sunxi-btlpm";
		bt_hostwake = <&r_pio 1 1 0>; /* PM1 */
		bt_wake = <&r_pio 1 2 0>; /* PM2 */
		/* Mux PM2 as gpio_out. Do not gpio-hog or drive a level. */
		pinctrl-names = "default";
		pinctrl-0 = <&pm_pins_bt_wake>;
		status = "okay";
	};

	sprd-mtty {
		compatible = "sprd,mtty";
		status = "okay";
	};

	openvfd {
		compatible = "open,vfd";
		dev_name = "openvfd";
		openvfd_gpio_clk = <&pio 7 3 0>; /* PH3 */
		openvfd_gpio_dat = <&pio 3 26 0>; /* PD26 */
		openvfd_chars = [02 04 03 02 01];
		openvfd_dot_bits = [00 01 02 03 04 05 06];
		openvfd_display_type = <0x05000001>;
		status = "okay";
	};

	reg_vcc_wifi: vcc-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc-wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&pio 7 4 0>; /* PH4, Android power_en */
		enable-active-high;
		startup-delay-us = <100000>;
	};

	/*
	 * USB2 host VBUS from the booted modified DTB: PC16, active-high,
	 * always-on. 6.12 fixed-regulator polarity comes from the GPIO
	 * flags (0 = GPIO_ACTIVE_HIGH); enable-active-high is ignored.
	 */
	reg_usb_host_vbus: usb-host-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-host-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pio 2 16 0>; /* PC16 */
		enable-active-high;
		regulator-always-on;
		status = "okay";
	};

	/*
	 * USB3 connector VBUS. Android usbc1 usb_drv_vbus_gpio is PL5
	 * driven high (r_pio bank 0 pin 5). always-on keeps the pin high
	 * across phy_power_off; boot-on requests it high at probe.
	 */
	reg_usb3_vbus: usb3-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb3-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&r_pio 0 5 0>; /* PL5, GPIO_ACTIVE_HIGH */
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_bt: regulator-bt {
		compatible = "regulator-fixed";
		regulator-name = "vcc-bt";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_vcc1v8: regulator-vcc1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc1v8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		phandle = <0x18>;
	};

	reg_vcc3v3: vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x19>;
	};

	reg_vcc5v: vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x06>;
	};

	wifi_pwrseq: wifi_pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rtc 1>;
		clock-names = "ext_clock";
		/* Android wlan_regon = PM3, the UWE5622 chip enable.
		 * Active-low so the pin idles high (chip on). */
		reset-gpios = <&r_pio 1 3 1>;
		post-power-on-delay-ms = <200>;
		phandle = <0x1d>;
	};

	bt {
		compatible = "allwinner,sunxi-bt";
		clocks = <&rtc 1>;
		bt_power = "vcc-wifi";
		bt_io_regulator = "vcc-wifi-io";
		status = "okay";
		device_type = "bt";
		/* PM4 active-low reset. Mux only; no gpio-hog. */
		pinctrl-names = "default";
		pinctrl-0 = <&pm_pins_bt_reset>;
		bt_rst_n = <&r_pio 1 4 1>;
	};

